# Env vars for a production deploy of the Christimony Rails API.
#
# This file is NOT loaded automatically -- this app doesn't use dotenv,
# so copy each value into whatever your host actually uses to set env vars
# (Railway's Variables tab, `fly secrets set`, Render's Environment tab,
# or `.kamal/secrets` for a Kamal deploy). See docs/deploy.md for the
# full walkthrough and what each section below means in practice.
#
# Every value here is a PLACEHOLDER. Nothing in this file is a real
# secret, and it's safe to commit (see .gitignore's explicit exception
# for this one file).


# ============================================================
# REQUIRED -- the app will not boot without these.
# ============================================================

# The exact content of backend/config/master.key (gitignored, never
# commit it). Decrypts config/credentials.yml.enc, which holds
# secret_key_base. Get it with: cat config/master.key
RAILS_MASTER_KEY=

# Postgres connection. Every managed Postgres addon (Railway, Render,
# Fly's standard offering) runs as a separate host from your app, so
# HOST is effectively required too, even though Rails' own database.yml
# comment examples often omit it (that only works when Postgres runs on
# the SAME machine, e.g. Kamal).
BACKEND_DATABASE_HOST=
BACKEND_DATABASE_PASSWORD=
# Only needed if your host doesn't run Postgres on the default port.
BACKEND_DATABASE_PORT=5432
# Only needed if your host assigns its own Postgres username instead of
# letting you create a "backend" role (most managed addons do this --
# check whatever the addon's own dashboard/CLI shows you).
BACKEND_DATABASE_USERNAME=backend


# ============================================================
# STRONGLY RECOMMENDED -- the app boots without these, but the
# corresponding feature silently falls back to a dev-only behavior.
# ============================================================

# Without these, "Continue with Google" 401s with "sign-in is not
# configured" -- there's no fallback. Get GOOGLE_CLIENT_ID from Google
# Cloud Console (OAuth client, Web application type) -- same value the
# frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID uses. APPLE_CLIENT_IDS is a
# comma-separated LIST (plural): the web flow's Services ID AND every
# native app's bundle id, e.g. "com.christimony.web,app.christimony" --
# a native Sign in with Apple token's aud is the bundle id, not the
# Services ID, and Rails has to accept both. See backend/README.md's
# Authentication section for why this can't be a single value.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_IDS=

# Without these, SMS_PROVIDER effectively stays "log" (see below) --
# fine for you to test with, but no real phone ever receives an OTP.
SMS_PROVIDER=log
# log | twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# msg91 needs a DLT-registered template for Indian transactional SMS --
# leave both blank unless you already have one.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Without these, config/environments/production.rb falls back to LOCAL
# DISK storage for profile photos -- disk that does not survive a
# redeploy/restart on essentially every host. Every uploaded photo
# vanishes the next time you deploy. S3_ENDPOINT is only needed for a
# non-AWS provider (e.g. Cloudflare R2 -- cheaper egress; set
# S3_REGION=auto for R2).
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# Only needed once the web frontend is deployed somewhere OTHER than a
# *.vercel.app subdomain (those are always allowed). Comma-separated.
CORS_ORIGINS=https://your-frontend-domain.example.com

# Host used to build absolute URLs (e.g. in a background job, outside
# any request context) -- set this to your API's real public domain
# once you know it.
APP_HOST=
APP_PROTOCOL=https


# ============================================================
# OPTIONAL -- sensible defaults, only touch these if you know why.
# ============================================================

# Puma/ActiveRecord tuning. RAILS_MAX_THREADS also sets the DB
# connection pool size (config/database.yml) -- raise them together.
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info

# Thruster (the HTTP proxy in front of Puma, see Dockerfile) listens
# externally on HTTP_PORT (default 80, matching the Dockerfile's
# EXPOSE 80) and runs Puma internally on TARGET_PORT (default 3000,
# which Thruster maps to Puma's own PORT var itself -- don't set PORT
# directly, it'll be overwritten). Most Docker-native platforms
# auto-detect EXPOSE 80 and need neither of these. If your host insists
# on assigning its own dynamic port instead, set HTTP_PORT to that
# value (Railway: reference its $PORT variable).
# HTTP_PORT=80
# TARGET_PORT=3000
